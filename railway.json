{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace @admin/api"
  },
  "deploy": {
    "preDeployCommand": "npm run db:migrate",
    "startCommand": "npm run start --workspace @admin/api",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "watchPatterns": ["apps/api/**", "packages/**", "package.json", "package-lock.json"]
  }
}
