{
  "name": "@admin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set -a; [ -f ../../.env ] && . ../../.env; set +a; COOKIE_SECRET=${COOKIE_SECRET:-local-demo-cookie-secret} tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "set -a; [ -f ../../.env ] && . ../../.env; set +a; tsx src/infrastructure/database/runMigrations.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@admin/community-notices": "0.1.0",
    "@admin/contracts": "0.1.0",
    "@admin/incidents": "0.1.0",
    "@admin/meeting-minutes": "0.1.0",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "@napi-rs/canvas": "^0.1.80",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "tsx": "^4.21.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "3.2.6",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.1.4",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
